__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/

# LaTeX build intermediates. Keep the source PDF as a reviewed artifact.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz

# Closed-loop runs may create disposable scratch work here.
.loop-work/
.claude/*.lock
# Keep private_data available for selected research artifacts. Raw/generated
# contents remain local unless an individual path is explicitly allowed.
private_data/*
!private_data/task2_m3_0020/
private_data/task2_m3_0020/*
!private_data/task2_m3_0020/model.npz
!private_data/task2_control_modes_0078/
private_data/task2_control_modes_0078/*
!private_data/task2_control_modes_0078/evidence.json
!private_data/task2_control_modes_0078/modal_arrays.npz

# Publication staging remains local (preserved from the remote archive rules).
/_selected_private_data/
/_release_assets/
/_build_curated.py
/_original_assets/
/_build_original.py
external_data/

# Local runtime state and environments. These may contain retained evidence;
# ignoring them is not permission to delete them.
/.tmp/
/.tmp_*/
/tmp/
/.venv-*/

# Raw process identities, machine-specific commands and training traces.
# Publish a sanitized summary explicitly; keep the originals locally.
/results/**/reproduction/
/results/**/training_runs/
/results/**/identity.json
/results/**/child.log
/results/**/wall_receipt.json
