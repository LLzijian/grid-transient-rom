          {
            "line": 58,
            "text": "            cfg[\"backbone_raw\"][name + suffix] = _list(value)"
          },
          {
            "line": 87,
            "text": "        self.structured = StructuredROM("
          },
          {
            "line": 88,
            "text": "            mass=mass, D=D, coupling=cfg[\"coupling\"], delta_star=cfg[\"delta_star\"],"
          },
          {
            "line": 89,
            "text": "            damping=cfg[\"damping\"], gain=cfg[\"gain\"], jpi_p=cfg[\"jpi_p\"],"
          },
          {
            "line": 90,
            "text": "            rpp=cfg[\"rpp\"], storage_base=cfg[\"storage_base\"], n_q=0,"
          },
          {
            "line": 91,
            "text": "            storage=(), exchange=(), dissipation=(), ports=(), trainable=True).double()"
          },
          {
            "line": 92,
            "text": "        if \"backbone_raw\" in cfg:"
          },
          {
            "line": 100,
            "text": "                            (\"rate\", cfg[\"rate\"]), (\"gain\", cfg[\"gain\"]),"
          },
          {
            "line": 101,
            "text": "                            (\"input_scale_delta\", cfg[\"input_scale_delta\"]),"
          },
          {
            "line": 102,
            "text": "                            (\"input_scale_omega\", cfg[\"input_scale_omega\"]),"
          },
          {
            "line": 103,
            "text": "                            (\"p_scale\", cfg[\"p_scale\"])):"
          },
          {
            "line": 104,
            "text": "            self.register_buffer(name, _cpu(value))"
          },
          {
            "line": 105,
            "text": "        for name in (\"base_coupling\", \"rate\", \"gain\", \"input_scale_delta\", \"input_scale_omega\", \"p_scale\"):"
          },
          {
            "line": 106,
            "text": "            value = getattr(self, name)"
          },
          {
            "line": 107,
            "text": "            expected = len(D) if name == \"base_coupling\" else 10"
          },
          {
            "line": 108,
            "text": "            if value.shape != (expected,) or not torch.isfinite(value).all() or torch.any(value <= 0):"
