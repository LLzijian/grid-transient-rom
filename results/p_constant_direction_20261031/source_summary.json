        "lines": [
          {
            "line": 1,
            "text": "\"\"\"Fixed-action memory model for the registered 2026-10-25 comparison."
          },
          {
            "line": 2,
            "text": ""
          },
          {
            "line": 3,
            "text": "The interface is [delta, omega, p, r]; energy and matrices use pi=M*omega."
          },
          {
            "line": 4,
            "text": "Only the strict M3 backbone is copied.  No source q template or added port is"
          },
          {
            "line": 5,
            "text": "retained.  B/C differ exclusively by C's parameter-free causal initial-state"
          },
          {
            "line": 20,
            "text": ""
          },
          {
            "line": 21,
            "text": "FORMAT = \"r_memory_model_20261025\""
          },
          {
            "line": 22,
            "text": "_PHYSICAL = (\"coupling\", \"damping\", \"jpi_p\", \"rpp\", \"storage_base\")"
          },
          {
            "line": 23,
            "text": ""
          },
          {
            "line": 24,
            "text": ""
          },
          {
            "line": 44,
            "text": "           \"base_coupling\": _list(getattr(source, \"base_coupling\", core._pos(\"coupling\"))),"
          },
          {
            "line": 45,
            "text": "           \"input_scale_delta\": _list(getattr(source, \"input_scale_delta\", torch.ones(10))),"
          },
          {
            "line": 46,
            "text": "           \"input_scale_omega\": _list(getattr(source, \"input_scale_omega\", torch.ones(10))),"
          },
          {
            "line": 47,
            "text": "           \"p_scale\": _list(getattr(source, \"p_scale\", torch.ones(10)))}"
          },
          {
            "line": 48,
            "text": "    for name in _PHYSICAL:"
          },
          {
            "line": 49,
            "text": "        cfg[name] = _list(core._pos(name)[:10] if name == \"storage_base\" else core._pos(name))"
          },
          {
            "line": 50,
            "text": "    # Copy the raw coordinates as well: softplus->inverse-softplus need not"
          },
          {
            "line": 51,
            "text": "    # round-trip bitwise.  These tensors have no old memory components."
          },
          {
            "line": 54,
            "text": "        for suffix in (\"\", \"_mask\"):"
          },
          {
            "line": 55,
            "text": "            value = getattr(core, name + suffix)"
