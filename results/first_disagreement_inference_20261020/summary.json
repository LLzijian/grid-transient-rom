utput\", str(INNER),\n                      \"-TimeoutSeconds\", \"3570\", \"-MaxSeconds\", \"3600\",\n                      \"-SourceCommit\", args.source_commit, \"-FixtureIdentityJson\", str(WORKER)]\n    sys.path.insert(0, str(ROOT / \"experiments\"))\n    from fixed_edge_pair_20261019 import native_job\n    record = {\"status\": \"INCONCLUSIVE_NUMERICAL_OR_IMPLEMENTATION\", \"source_commit\": args.source_commit,\n              \"source_before\": before, \"native_command\": native_command,\n              \"native_outer_receipt\": str(OUTER / \"native.json\"),\n              \"native_inner_receipt\": str(INNER / \"receipt.json\"),\n              \"worker_identity\": str(WORKER), \"support_hold_seconds\": 900}\n    started = time.perf_counter()\n    try:\n        outer = native_job(native_command, OUTER, 3600, worker_json=WORKER)\n        record[\"outer\"] = outer\n        if (INNER / \"receipt.json\").is_file():\n            record[\"inner\"] = json.loads((INNER / \"receipt.json\").read_text(encoding=\"utf-8\"))\n        if WORKER.is_file():\n            record[\"worker\"] = json.loads(WORKER.read_text(encoding=\"utf-8\"))\n        final = WORKER.parent / \"final.json\"\n        if final.is_file():\n            science = json.loads(final.read_text(encoding=\"utf-8\"))\n            record[\"scientific_result\"] = {\"status\": science.get(\"status\"),\n                                            \"row_count\": len(science.get(\"rows\", [])),\n                                            \"final_sha256\": sha(final)}\n        record[\"source_after\"] = source_hashes(manifest)\n        inner = record.get(\"inner\", {})\n        worker = record.get(\"worker\", {})\n        valid = (outer.get(\"status\") == \"COMPLETED\" and outer.get(\"exit_code\") == 0\n                 and outer.get(\"native_receipt_complete\") is True\n                 and inner.get(\"status\") == \"COMPLETED\" and inner.get(\"exit_code\") == 0\n                 and inner.get(\"native_receipt_comple